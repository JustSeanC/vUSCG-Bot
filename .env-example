# Discord bot token
DISCORD_TOKEN=your_discord_token_here

# MySQL database connection. Use the version-specific training migration path.
# Keep strict SQL mode and foreign_key_checks enabled on the runtime connection.
DB_HOST=localhost
DB_USER=username
DB_PASSWORD=password
DB_NAME=database_name

# RapidAPI key for IsItWater
RAPIDAPI_KEY=your_rapidapi_key_here

# Mapbox API token for map images
MAPBOX_TOKEN=your_mapbox_token_here

CLIENT_ID=DISCORDCLIENT
GUILD_ID=GUILDID
COMMAND_STAFF_ROLE_ID=COMMANDROLE
INSTRUCTOR_PILOT_ROLE_ID=IPROLEID

# Confirm the Discord channel IDs before deployment. The prior manual PIREP
# destination was hard-coded, so its Mission Notices identity cannot be proven here.
MANUAL_PIREP_CHANNEL_ID=MISSION_NOTICES_CHANNEL_ID
CGAS_TOUR_CHANNEL_ID=MISSION_NOTICES_CHANNEL_ID
CGAS_TOUR_CHECK_INTERVAL_SECONDS=300
# Optional; leave blank to disable completion-role awards.
CGAS_TOUR_ROLE_ID=
# phpVMS award ID from /admin/awards/{id}; migration 003 is required.
CGAS_TOUR_AWARD_ID=16

# Native phpVMS PIREP review bridge. Set only for a verified installation.
PIREP_BRIDGE_URL=
PIREP_BRIDGE_SECRET=

# Optional HTTPS prefix for report links, including training history and announcements.
# PIREP_BASE_URL=


# P04 staff dashboard (UTC days since latest effective training date).
TRAINING_FOLLOWUP_DAYS=30
# MR rank and Discord delivery. Enable only after verifying mappings on staging.
# The supplied vUSCG rank 13 name is O-2 Lieutenant (junior grade); verify it on staging.
TRAINING_GRADUATION_ENABLED=false
TRAINING_GRADUATION_RANK_NAME=
TRAINING_GRADUATION_PILOT_ROLE_ID=
TRAINING_GRADUATION_CADET_ROLE_ID=
TRAINING_GRADUATION_O2_ROLE_ID=
TRAINING_GRADUATION_RW_ROLE_ID=
TRAINING_GRADUATION_FW_ROLE_ID=

# P06 private enrollment and materials message delivery; set false to pause sends.
TRAINING_INSTRUCTION_DELIVERY_ENABLED=false
# Keep native trainee delivery disabled in the phpVMS Laravel environment until staged.
# For isolated tests only: TRAINING_TEST_MYSQL_VERSION=5.7.44 or 8.4, with a loopback fixture port.
# See docs/training-p07-phpmyadmin-installation.md for PHP flags and the path selector.
