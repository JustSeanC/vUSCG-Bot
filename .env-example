# Discord bot token
DISCORD_TOKEN=your_discord_token_here

# MySQL Database connection
DB_HOST=localhost
DB_USER=username
DB_PASSWORD=password
DB_NAME=database_name

# RapidAPI key for IsItWater
RAPIDAPI_KEY=your_rapidapi_key_here

# Mapbox API token for map images
MAPBOX_TOKEN=your_mapbox_token_here

CLIENT_ID=DISCORDCLIENT
GUILD_ID=GUILDID
COMMAND_STAFF_ROLE_ID=COMMANDROLE
INSTRUCTOR_PILOT_ROLE_ID=IPROLEID

# Confirm the Discord channel IDs before deployment. The prior manual PIREP
# destination was hard-coded, so its Mission Notices identity cannot be proven here.
MANUAL_PIREP_CHANNEL_ID=MISSION_NOTICES_CHANNEL_ID
CGAS_TOUR_CHANNEL_ID=MISSION_NOTICES_CHANNEL_ID
CGAS_TOUR_CHECK_INTERVAL_SECONDS=300
# Optional; leave blank to disable completion-role awards.
CGAS_TOUR_ROLE_ID=
# phpVMS award ID from /admin/awards/{id}; migration 003 is required.
CGAS_TOUR_AWARD_ID=16
